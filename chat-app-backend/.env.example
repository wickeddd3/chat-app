NODE_ENV=development
PORT=4000

# Database
# Use localhost for host-run tooling (prisma migrate, npm run seed) — e.g.
# postgresql://root:root@localhost:5435/chat_app_db. The host port is 5435, not
# the default 5432, so this stack can run alongside other local Postgres
# containers; see docker-compose.yml. The docker-compose backend overrides this
# to the `db` service host inside the container, so use localhost here;
# `db:5432` only resolves inside the Docker network (and stays 5432 there — the
# remapping is host-side only).
DATABASE_URL=

# Integration test database (optional). Used by `npm run test:int` / test:coverage
# for the real-DB integration suite. Defaults to a separate `chat_app_test`
# database on the local Postgres (auto-created + migrated), so dev data is never
# touched. Only set this to override the default connection.
# TEST_DATABASE_URL=postgresql://root:root@localhost:5435/chat_app_test

# Redis
# Same as above: use localhost:6379 on the host; compose overrides to `redis`.
REDIS_URL=

# Supabase Auth (Backend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend Domain URL
APP_URL=

# Logging level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info