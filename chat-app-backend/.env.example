NODE_ENV=development
PORT=4000

# Database
# Use localhost for host-run tooling (prisma migrate, npm run seed) — e.g.
# postgresql://root:root@localhost:5432/chat_app_db. The docker-compose backend
# overrides this to the `db` service host inside the container, so use localhost
# here; `db:5432` only resolves inside the Docker network.
DATABASE_URL=

# Redis
# Same as above: use localhost:6379 on the host; compose overrides to `redis`.
REDIS_URL=

# Supabase Auth (Backend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend Domain URL
APP_URL=

# Logging level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info