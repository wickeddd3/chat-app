// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "./generated"
  // Emit CommonJS so the compiled `node dist` build (a CJS project) can require
  // the client without ESM-interop errors. tsx handles either format in dev.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum NotificationType {
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  CHANNEL_INVITE
}

enum ChannelType {
  DIRECT
  GROUP
}

enum ChannelRole {
  ADMIN
  MEMBER
}

model User {
  id              String   @id
  name            String
  image           String?
  username        String?  @unique
  lastSeen        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  channels Channel[]
  channelMembers ChannelMember[]

  messages Message[]
  messageReceipts MessageReceipt[]

  // Connections initiated by this user
  sentConnections     Connection[] @relation("SentConnections")
  // Connections targeting this user
  receivedConnections Connection[] @relation("ReceivedConnections")
  // Notifications for this user
  notifications       Notification[]

  @@map("users")
}

model Connection {
  id          String           @id @default(uuid())
  senderId    String
  receiverId  String
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  sender      User             @relation("SentConnections", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User             @relation("ReceivedConnections", fields: [receiverId], references: [id], onDelete: Cascade)

  // Ensure unique pair records to avoid double requesting
  @@unique([senderId, receiverId])
  @@index([senderId, status])
  @@index([receiverId, status])
  @@map("connections")
}

model Notification {
  id          String           @id @default(uuid())
  userId      String           // Receiver of the notification
  type        NotificationType
  title       String
  content     String
  isRead      Boolean          @default(false)
  referenceId String?          // Optional: Store Connection ID or Channel ID for client linking
  createdAt   DateTime         @default(now())

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  // Allow efficient compound cursor execution layouts
  @@index([createdAt, id])
  @@unique([createdAt, id])
  @@map("notifications")
}

model Channel {
  id        Int       @id @default(autoincrement())
  name      String
  type      ChannelType
  authorId  String
  createdBy User      @relation(fields: [authorId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  channelMembers  ChannelMember[]
  messages  Message[]

  @@index([id])
  @@index([updatedAt])
  @@map("channels")
}

model ChannelMember {
  id          Int       @id @default(autoincrement())
  channelId   Int
  channel     Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        ChannelRole
  joinedAt    DateTime  @default(now())

  @@unique([channelId, userId]) // One channel member per user
  @@map("channel_members")
}

model Message {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())
  channelId Int
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])

  parentId  Int?
  parent    Message?  @relation("MessageToMessage", fields: [parentId], references: [id])
  replies   Message[] @relation("MessageToMessage")

  readBy    MessageReceipt[]

  @@index([channelId, createdAt(sort: Asc)])
  @@map("messages")
}

model MessageReceipt {
  id        Int      @id @default(autoincrement())
  messageId Int
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime @default(now())

  @@unique([messageId, userId]) // One receipt per user per message
  @@map("message_receipts")
}
